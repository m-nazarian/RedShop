
# RedShop environment example
# Copy this file to .env for local development, or configure these variables in production.
# Never commit a real .env file.

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_SETTINGS_MODULE=RedShop.settings

POSTGRES_DB=redshop_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=replace-with-app-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=RedShop <noreply@example.com>

ZARINPAL_MERCHANT_ID=replace-with-merchant-id
ZARINPAL_SANDBOX=true

DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_HTTPONLY=false
DJANGO_SECURE_HSTS_SECONDS=2592000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=false
REDSHOP_ENFORCE_CSP=true

# Optional:
# REDSHOP_ENV_FILE=/path/to/.env
