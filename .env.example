# نمونه تنظیمات RedShop
# مقدارهای واقعی فقط در .env یا محیط سیستم قرار می‌گیرند.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

DB_ENGINE=django.db.backends.postgresql
DB_NAME=redshop_db
DB_USER=redshop_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_BROKER=https://sandbox.zarinpal.com/pg/v4/payment/
ZARINPAL_START_PAY_URL=https://sandbox.zarinpal.com/pg/StartPay/
ZARINPAL_CALLBACK_URL=http://127.0.0.1:8000/payment/verify/

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost

SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
